# ─────────────────────────────────────────────────────────────────────────
# Dupe environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored. Never commit real tokens.
# ─────────────────────────────────────────────────────────────────────────

# Pinned Meta Graph API version. Don't float this, Meta changes field shapes.
META_GRAPH_VERSION=v23.0

# Meta App credentials (App Dashboard > Settings > Basic).
META_APP_ID=
META_APP_SECRET=

# Access token with ads_management.
# A long-lived System User token is ideal. The token's identity must have access
# to BOTH the ad account AND every Facebook Page you publish from, otherwise
# page-bound ad creation fails. A normal User token works too if you administer
# the Pages.
META_SYSTEM_USER_TOKEN=

# Optional per-account token override.
# Name it META_TOKEN_<SLUG> to match a slug in config/accounts.ts.
# Falls back to META_SYSTEM_USER_TOKEN when unset.
# META_TOKEN_ACME=

# Optional: configure ad accounts via env instead of editing config/accounts.ts.
# A JSON array of { id, label, slug, storeCodeDigits, tokenEnvVar?, passwordEnvVar? }.
# Wins over config/accounts.ts when set, so real account ids never touch the repo.
# ACCOUNTS_JSON=[{"id":"1234567890","label":"Acme","slug":"acme","storeCodeDigits":4}]

# Optional: which discovery data source to use.
#   auto (default) - live when Meta creds exist, else the on-disk snapshot, else
#                    the mapping store-list.
#   snapshot | live | mapping - force a single source.
# DISCOVERY_SOURCE=auto

# Optional: supply a store->Page mapping as env instead of a data/mapping/<slug>.csv file,
# so a hosted deploy can map without committing client data. Name it MAPPING_<SLUG> (slug
# uppercased, non-alphanumerics -> "_", e.g. MAPPING_ACME); value = the raw CSV text (same
# format as data/mapping/<slug>.csv). Wins over the file when present. In Vercel you can
# paste the multi-line CSV straight into the value box.
# MAPPING_ACME=

# The ad name Dupe treats as each campaign's template.
# Default is an exact, case-insensitive match on "Template".
TEMPLATE_AD_NAME=Template

# Anthropic API key. Powers the "Generate Copy" button.
# Get a key at https://console.anthropic.com/.
# Optional. Without it, Generate Copy returns 503 and the rest of the app works fine.
ANTHROPIC_API_KEY=

# Optional model override for Generate Copy.
ANTHROPIC_COPY_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────────────────
# Optional team login portal (only needed if AUTH_ENABLED=true)
# Dupe runs OPEN by default. Everything below is unused unless you turn auth on.
# ─────────────────────────────────────────────────────────────────────────

# Set to true to require login. Off by default.
AUTH_ENABLED=

# Safety guard: in production, if Meta live credentials are set but AUTH_ENABLED is not
# "true", the app refuses to start, so it can never run open with a live ad account. If
# your deployment is gated another way (Cloudflare Access, IP allowlist), set this to
# "true" to allow open + live on purpose.
# ALLOW_UNAUTHENTICATED_LIVE=

# One password per ad account. Name it APP_PASSWORD_<SLUG> to match a slug in
# config/accounts.ts (wired via that account's `passwordEnvVar` field).
# A teammate who signs in with this password is locked to that one account.
# APP_PASSWORD_ACME=

# Secret used to sign session cookies. Required when AUTH_ENABLED=true in
# production. Generate one with: openssl rand -hex 32
APP_SESSION_SECRET=
